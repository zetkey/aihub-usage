def cmd_status(base):
    st = get_status(base)
    qpu = st.get("quota_per_unit") or DEFAULT_QUOTA_PER_UNIT
    rates = st.get("currency_rates") or {}
    docs = str(st.get("docs_link") or "/docs/")
    if not docs.startswith(("http://", "https://")):
        docs = base + "/" + docs.lstrip("/")
    return {
        "base_url": base,
        "gateway": st.get("system_name"),
        "version": st.get("version"),
        "quota_per_unit": qpu,
        "quota_display_type": st.get("quota_display_type"),
        "currency_rates": rates,
        "docs": docs,
    }


def collect(args, base, key):
    out = {"base_url": base}

    # Semua request di bawah saling independen, jadi dijalankan paralel: satu
    # round-trip TLS per endpoint membuat versi sekuensial memakan waktu
    # ~850 ms, sedangkan paralel ~220 ms (terlama yang menentukan).
    jobs = {"status": lambda: get_status(base)}
    # --warn-below butuh saldo akun, jadi selalu ikut diambil walau command-nya
    # bukan `balance` (mis. `aihub-usage key --warn-below 5`).
    if args.command in ("all", "balance") or args.warn_below is not None:
        jobs["balance"] = lambda: get_balance(base, key)
    if args.command in ("all", "key", "tokens"):
        jobs["token"] = lambda: get_token_usage(base, key)
    # `all` dan `tokens` perlu jendela log untuk ringkasan token; `logs` untuk
    # tabelnya. Satu kali ambil, dipakai keduanya.
    if args.command in ("all", "logs", "tokens"):
        jobs["logs"] = lambda: get_logs(base, key)
    if args.command == "models":
        jobs["models"] = lambda: get_models(base, key)

    results = {}
    if jobs:
        with ThreadPoolExecutor(max_workers=min(len(jobs), 8)) as ex:
            futs = {name: ex.submit(fn) for name, fn in jobs.items()}
            for name, fut in futs.items():
                try:
                    results[name] = fut.result()
                except ApiError as e:
                    out[name + "_error"] = e.message

    st = results.get("status")
    if st is not None:
        out["status"] = {
            "gateway": st.get("system_name"),
            "version": st.get("version"),
            "quota_per_unit": st.get("quota_per_unit") or DEFAULT_QUOTA_PER_UNIT,
            "currency_rates": st.get("currency_rates") or {},
        }
    status = out.get("status") or {}
    qpu = status.get("quota_per_unit") or DEFAULT_QUOTA_PER_UNIT
    rates = status.get("currency_rates") or {}
    for name in ("balance", "token", "logs", "models"):
        if name in results:
            out[name] = results[name]
    if "logs" in out:
        out["tokens"] = summarize_tokens(out["logs"], qpu)
        # Arsip lokal (default off, lihat store_enabled): arsipkan dulu, lalu
        # hitung dari arsip supaya angka melampaui batas 1000 log terakhir milik
        # gateway. Kalau arsip tidak bisa dipakai, tetap laporkan angka jendela
        # beserta peringatannya.
        if store_enabled(args):
            conn, err = open_store()
            if conn is None:
                out["store_error"] = err
            else:
                try:
                    scope = scope_of(key)
                    added, gap = store_logs(conn, scope, out["logs"])
                    out["tokens"] = store_summary(conn, scope, qpu,
                                                  len(out["logs"]), added, gap)
                except sqlite3.Error as e:
                    out["store_error"] = str(e)
                finally:
                    conn.close()
    elif args.command in ("all", "tokens"):
        # untuk `logs` kegagalannya sudah dilaporkan bagian LOG, tidak perlu dobel
        out["tokens_error"] = out["logs_error"]
    out["_qpu"] = qpu
    out["_rates"] = rates
    return out



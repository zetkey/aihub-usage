def cmd_probe(args, base, key):
    model = args.model
    if not model:
        models = get_models(base, key)
        if not models:
            fail("tidak ada model yang tersedia untuk key ini; pakai --model <nama>")
        model = models[0]
    if args.anthropic:
        body = {"model": model, "max_tokens": args.max_tokens,
                "messages": [{"role": "user", "content": "hi"}]}
        data = api(base, "/v1/messages", key, method="POST", body=body,
                   headers={"anthropic-version": "2023-06-01"})
        usage = data.get("usage") or {}
        text = "".join(b.get("text", "") for b in (data.get("content") or [])
                       if isinstance(b, dict))
        result = {"endpoint": "/v1/messages", "model": data.get("model", model),
                  "input_tokens": usage.get("input_tokens"),
                  "output_tokens": usage.get("output_tokens"), "content": text[:60]}
    else:
        body = {"model": model, "max_tokens": args.max_tokens,
                "messages": [{"role": "user", "content": "hi"}]}
        data = api(base, "/v1/chat/completions", key, method="POST", body=body)
        usage = data.get("usage") or {}
        choices = data.get("choices") or []
        choice = choices[0] if choices else {}
        msg = choice.get("message") if isinstance(choice, dict) else None
        if not isinstance(msg, dict):
            msg = dict()
        result = {"endpoint": "/v1/chat/completions", "model": data.get("model", model),
                  "prompt_tokens": usage.get("prompt_tokens"),
                  "completion_tokens": usage.get("completion_tokens"),
                  "content": str(msg.get("content", ""))[:60]}
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return
    print("OK (%s)  model=%s" % (result["endpoint"], result["model"]))
    if args.anthropic:
        print("  input  : %s token" % result["input_tokens"])
        print("  output : %s token" % result["output_tokens"])
    else:
        print("  prompt : %s token" % result["prompt_tokens"])
        print("  output : %s token" % result["completion_tokens"])
    print("  jawab  : %r" % result["content"])


def write_config(cfg):
    """Tulis config.json mode 0600 (dibuat langsung 0600, bukan chmod belakangan)."""
    cfg_dir = os.path.dirname(CONFIG_PATH)
    if cfg_dir:
        os.makedirs(cfg_dir, exist_ok=True)
    # fchmod SEBELUM menulis: mode pada os.open hanya berlaku saat file dibuat,
    # jadi file lama yang longgar akan tetap longgar sampai chmod di bawah —
    # cukup lama untuk key baru terlihat pihak lain. chmod tetap dipanggil untuk
    # merapikan path (mis. file yang diganti proses lain).
    fd = os.open(CONFIG_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, stat.S_IRUSR | stat.S_IWUSR)
    except OSError:
        pass  # mis. filesystem tanpa dukungan chmod; chmod di bawah jadi cadangan
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)
    os.chmod(CONFIG_PATH, stat.S_IRUSR | stat.S_IWUSR)

def cmd_save_key(args, base, key):
    cfg = load_config()
    cfg["api_key"] = key
    if args.base_url:
        cfg["base_url"] = base
    # `save-key --store` / `--no-store` sekalian mengatur arsip lokal.
    if args.store:
        cfg["local_store"] = True
    elif args.no_store:
        cfg.pop("local_store", None)
    write_config(cfg)
    print("API key disimpan di %s (mode 0600)." % CONFIG_PATH)
    if args.store:
        print("Arsip log lokal: AKTIF (local_store=true). "
              "Nonaktifkan dengan: aihub-usage store off")
    elif args.no_store:
        print("Arsip log lokal: nonaktif (local_store dihapus dari config).")

def cmd_store(args):
    """`store [on|off|status]` — atur arsip log lokal tanpa perlu API key."""
    action = args.action or "status"
    cfg = load_config()
    active = truthy(cfg.get("local_store"))

    if action == "status":
        print("Arsip log lokal: %s" % ("AKTIF" if active else "nonaktif (default)"))
        print("  config : %s%s" % (CONFIG_PATH, "" if os.path.exists(CONFIG_PATH) else " (belum ada)"))
        print("  db     : %s%s" % (DB_PATH, "" if os.path.exists(DB_PATH) else " (belum dibuat)"))
        print("  flag   : %s" % ("local_store=true" if active else "local_store tidak diset"))
        print("  ubah   : aihub-usage store on  |  aihub-usage store off")
        return 0

    if action == "on":
        cfg["local_store"] = True
        write_config(cfg)
        print("Arsip log lokal: AKTIF (local_store=true di %s)." % CONFIG_PATH)
        print("Token akan dihitung dari gabungan arsip + API pada run berikutnya.")
    else:  # off
        cfg.pop("local_store", None)
        write_config(cfg)
        print("Arsip log lokal: nonaktif (local_store dihapus dari %s)." % CONFIG_PATH)
        if os.path.exists(DB_PATH):
            print("Arsip yang sudah ada tetap di %s (tidak dihapus)." % DB_PATH)
            print("Hapus manual bila tidak diperlukan: rm -f %s" % DB_PATH)
    return 0


def nonneg_int(s):
    try:
        n = int(s)
    except ValueError:
        raise argparse.ArgumentTypeError("harus bilangan bulat: %r" % s)
    if n < 0:
        raise argparse.ArgumentTypeError("tidak boleh negatif")
    return n

def positive_int(s):
    try:
        n = int(s)
    except ValueError:
        raise argparse.ArgumentTypeError("harus bilangan bulat: %r" % s)
    if n < 1:
        raise argparse.ArgumentTypeError("harus >= 1")
    return n

def main():
    p = argparse.ArgumentParser(
        prog="aihub-usage",
        description="Cek sisa credit & pemakaian API key di Scala AI Gateway (aihub.metranet.co.id).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Contoh:\n"
               "  aihub-usage                          # status + credit + info key + token\n"
               "  aihub-usage tokens                   # pemakaian token + rincian per model\n"
               "  aihub-usage balance --warn-below 5   # exit code 3 kalau sisa < $5\n"
               "  aihub-usage logs -n 20               # 20 request terakhir key ini\n"
               "  aihub-usage models                   # daftar model\n"
               "  aihub-usage store on                 # aktifkan arsip log lokal\n"
               "  aihub-usage store off                # nonaktifkan arsip log lokal\n"
               "  aihub-usage probe --anthropic        # tes 1 request via /v1/messages\n"
               "  aihub-usage --json                   # output JSON untuk script lain\n")
    p.add_argument("command", nargs="?",
                   choices=["all", "balance", "key", "logs", "tokens", "models",
                            "status", "probe", "save-key", "store"],
                   default="all")
    p.add_argument("action", nargs="?",
                   choices=["on", "off", "status"],
                   help="aksi untuk `store` (default: status)")
    p.add_argument("--key", help="API key (sk-...); default $AIHUB_API_KEY / file "
                                 "config. Hati-hati: key di argv terlihat oleh "
                                 "`ps` dan tersimpan di riwayat shell")
    p.add_argument("--key-file", help="baca API key dari baris pertama file")
    p.add_argument("--base-url", help="override base URL (default %s)" % DEFAULT_BASE)
    p.add_argument("--json", action="store_true", help="output JSON")
    p.add_argument("-n", "--limit", type=nonneg_int, default=10,
                   help="jumlah baris tabel log yang ditampilkan (default 10); "
                        "ringkasan token tetap dihitung dari seluruh log yang dikirim gateway")
    p.add_argument("--warn-below", type=float, metavar="USD",
                   help="exit code 3 kalau sisa credit di bawah nilai ini "
                        "(saldo ikut diambil walau command-nya bukan `balance`)")
    p.add_argument("--model", help="model untuk probe")
    p.add_argument("--max-tokens", type=positive_int, default=1,
                   help="max_tokens probe (default 1)")
    p.add_argument("--store", action="store_true",
                   help="aktifkan arsip log lokal untuk run ini (default: "
                        "mengikuti \"local_store\" di config.json / $AIHUB_STORE)")
    p.add_argument("--no-store", action="store_true",
                   help="paksa lewati arsip log lokal (hitung hanya dari jendela "
                        "log gateway)")
    p.add_argument("--anthropic", action="store_true", help="probe lewat /v1/messages")
    args = p.parse_args()

    base = resolve_base(args)

    # `action` hanya bermakna untuk `store`; menolak sisanya mencegah typo seperti
    # `aihub-usage balance status` diterima diam-diam lalu diabaikan.
    if args.action and args.command != "store":
        p.error("argumen %r hanya berlaku untuk `aihub-usage store on|off|status`"
                % args.action)

    if args.command == "store":
        return cmd_store(args)

    if args.command == "save-key":
        # Lewat resolve_key supaya --key-file / $AIHUB_API_KEY juga diterima;
        # memaksa --key berarti key selalu masuk argv (terlihat `ps` dan
        # tersimpan di riwayat shell).
        cmd_save_key(args, base, resolve_key(args, required=True))
        return 0

    key = resolve_key(args, required=(args.command != "status"))

    try:
        if args.command == "status":
            info = cmd_status(base)
            print(json.dumps(info, indent=2, ensure_ascii=False) if args.json
                  else "Scala AI Gateway — %s\n  base URL : %s\n  versi    : %s\n"
                       "  satuan   : %s quota = $1\n  kurs     : %s\n  docs     : %s" % (
                           info.get("gateway"), info["base_url"], info.get("version"),
                           format_quota(info["quota_per_unit"]),
                           kurs_str(info.get("currency_rates")), info["docs"]))
        elif args.command == "probe":
            cmd_probe(args, base, key)
        else:
            result = collect(args, base, key)
            print_report(result, args)
            error_key, label = SECTION_ERRORS.get(args.command, ("balance_error", "credit"))
            if result.get(error_key):
                print("\nGagal mengambil data %s: %s" % (label, result[error_key]),
                      file=sys.stderr)
                return 1
            if result.get("balance_error"):
                print("\nGagal mengambil data credit: %s" % result["balance_error"],
                      file=sys.stderr)
                return 1
            if args.warn_below is not None:
                rem = result["balance"]["remaining_usd"]
                if rem < args.warn_below:
                    print("\n!! SISA CREDIT %s DI BAWAH BATAS %s" %
                          (usd(rem), usd(args.warn_below)), file=sys.stderr)
                    return 3
    except ApiError as e:
        fail(e.message)

    return 0


if __name__ == "__main__":
    # `aihub-usage tokens | head` menutup stdout lebih awal; perilaku tool Unix
    # yang benar adalah mati karena SIGPIPE, bukan mencetak traceback.
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)

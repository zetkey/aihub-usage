class ApiError(Exception):
    def __init__(self, status, message, body=None):
        super().__init__(message)
        self.status = status
        self.message = message
        self.body = body


# --------------------------------------------------------------------------- io


class SafeRedirect(urllib.request.HTTPRedirectHandler):
    """Ikuti redirect, tapi jangan bocorkan API key ke host/skema lain.

    urllib bawaan menyalin header Authorization apa adanya saat mengikuti 3xx,
    jadi endpoint/proxy yang membalas redirect bisa menerima key kita. Di sini
    header itu dilepas bila host atau skema tujuan berbeda, dan redirect
    https->http ditolak (return None -> urllib melempar HTTPError 3xx, yang
    diperlakukan sebagai error oleh api()).
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is None:
            return None
        old = urllib.parse.urlsplit(req.full_url)
        target = urllib.parse.urlsplit(newurl)
        if old.scheme == "https" and target.scheme == "http":
            return None
        if (old.scheme, old.netloc) != (target.scheme, target.netloc):
            new.remove_header("Authorization")
        return new


OPENER = urllib.request.build_opener(SafeRedirect)

def read_body(resp):
    """Baca body, buka gzip/deflate bila gateway mengompresnya.

    /api/log/token bisa >500 KB mentah; dengan gzip turun ke ~30 KB sehingga
    request itu jauh lebih cepat. urllib tidak membuka kompresi sendiri.
    """
    raw = resp.read()
    enc = (resp.headers.get("Content-Encoding") or "").strip().lower()
    if enc == "gzip":
        raw = gzip.decompress(raw)
    elif enc == "deflate":
        try:
            raw = zlib.decompress(raw)
        except zlib.error:
            raw = zlib.decompress(raw, -zlib.MAX_WBITS)
    return raw.decode("utf-8", "replace")


def http(method, url, key=None, body=None, headers=None, timeout=TIMEOUT):
    """Return (status, parsed_json_or_text). Tidak pernah mencetak key."""
    hdrs = {"Accept": "application/json", "User-Agent": "aihub-usage/1.0",
            "Accept-Encoding": "gzip, deflate"}
    if key:
        hdrs["Authorization"] = "Bearer " + key
    if headers:
        hdrs.update(headers)
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        hdrs["Content-Type"] = "application/json"
    try:
        req = urllib.request.Request(url, data=data, headers=hdrs, method=method)
    except ValueError as e:
        # --base-url / $AIHUB_BASE_URL yang bukan URL (mis. "foo" tanpa skema)
        raise ApiError(0, "base URL tidak valid (%s): %s" % (e, url))
    try:
        with OPENER.open(req, timeout=timeout) as r:
            raw = read_body(r)
            status = r.status
    except urllib.error.HTTPError as e:
        raw = read_body(e)
        status = e.code
    except urllib.error.URLError as e:
        raise ApiError(0, "tidak bisa konek ke %s (%s)" % (url, e.reason))
    except OSError as e:
        raise ApiError(0, "network error: %s" % e)
    except (http.client.HTTPException, gzip.BadGzipFile, zlib.error) as e:
        # balasan rusak dari gateway/proxy (status line tidak valid, body terpotong)
        raise ApiError(0, "balasan tidak valid dari %s: %s" % (url, e))
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, raw


def fail(msg, code=1):
    print("ERROR: " + msg, file=sys.stderr)
    sys.exit(code)


def load_config():
    if not os.path.exists(CONFIG_PATH):
        return {}
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
        return cfg if isinstance(cfg, dict) else {}
    except Exception as e:
        fail("config %s tidak bisa dibaca: %s" % (CONFIG_PATH, e))


def resolve_key(args, required=True):
    if args.key:
        return args.key.strip()
    if args.key_file:
        try:
            with open(os.path.expanduser(args.key_file)) as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#"):
                        return line
        except OSError as e:
            fail("tidak bisa baca --key-file: %s" % e)
        fail("--key-file kosong")
    env = os.environ.get("AIHUB_API_KEY", "").strip()
    if env:
        return env
    cfg = load_config()
    if cfg.get("api_key"):
        return str(cfg["api_key"]).strip()
    if not required:
        return None
    fail(
        "API key belum ada. Set salah satu:\n"
        "  export AIHUB_API_KEY=sk-...\n"
        "  aihub-usage --key sk-... <command>\n"
        "  aihub-usage --key-file ~/.config/aihub/key <command>\n"
        "  aihub-usage --key sk-... save-key   (simpan ke %s)" % CONFIG_PATH
    )


def resolve_base(args):
    if args.base_url:
        return args.base_url.rstrip("/")
    env = os.environ.get("AIHUB_BASE_URL", "").strip()
    if env:
        return env.rstrip("/")
    cfg = load_config()
    if cfg.get("base_url"):
        return str(cfg["base_url"]).rstrip("/")
    return DEFAULT_BASE


def api(base, path, key, method="GET", body=None, headers=None):
    status, data = http(method, base + path, key=key, body=body, headers=headers)
    if status == 401:
        raise ApiError(401, "API key ditolak (401). Cek key / apakah key masih aktif.")
    if status == 403:
        msg = data.get("message") if isinstance(data, dict) else data
        raise ApiError(403, "akses ditolak (403): %s" % msg)
    if status >= 400:
        if isinstance(data, dict):
            err = data.get("error") or {}
            msg = err.get("message") if isinstance(err, dict) else None
            msg = msg or data.get("message") or json.dumps(data)
        else:
            msg = str(data)[:200]
        raise ApiError(status, "HTTP %s: %s" % (status, msg))
    if 300 <= status < 400:
        # redirect yang tidak diikuti (mis. https->http) — jangan diteruskan
        # sebagai "data", karena body-nya halaman redirect, bukan JSON.
        raise ApiError(status, "HTTP %s: redirect tidak diikuti (%s)" % (status, path))
    if isinstance(data, dict) and isinstance(data.get("error"), dict) and data["error"].get("message"):
        raise ApiError(status, data["error"]["message"])
    # new-api membalas error handler dengan HTTP 200 + {"success":false, ...}
    # (common.ApiError/ApiErrorI18n); tanpa cek ini kegagalan terbaca sebagai
    # "tidak ada data".
    if isinstance(data, dict) and (data.get("success") is False or data.get("code") is False):
        raise ApiError(status, "%s gagal: %s" % (path, data.get("message") or "ditolak gateway"))
    return data


# ------------------------------------------------------------------- endpoints


def get_status(base):
    """GET /api/status — endpoint publik, tidak butuh API key."""
    status, data = http("GET", base + "/api/status")
    if status != 200 or not isinstance(data, dict):
        raise ApiError(status, "gagal ambil /api/status")
    return data.get("data", data)


def get_balance(base, key):
    """Credit akun dari sudut pandang API key (endpoint [OI]-compatible)."""
    sub = api(base, "/v1/dashboard/billing/subscription", key)
    use = api(base, "/v1/dashboard/billing/usage", key)
    total = float(sub.get("hard_limit_usd") or 0.0)
    used = float(use.get("total_usage") or 0.0) / 100.0  # endpoint ini pakai cent
    return {
        "total_usd": total,
        "used_usd": used,
        "remaining_usd": total - used,
        "access_until": sub.get("access_until") or 0,
    }


def get_token_usage(base, key):
    d = api(base, "/api/usage/token/", key)
    return d.get("data") or {}


def get_logs(base, key):
    d = api(base, "/api/log/token", key)
    return d.get("data") or []


def get_models(base, key):
    d = api(base, "/v1/models", key)
    return [m.get("id") for m in (d.get("data") or []) if m.get("id")]


# ------------------------------------------------------------------- formatting


def usd(x, unit="$"):
    return "%s%s" % (unit, format_money(x))


def format_money(x):
    return "{:,.4f}".format(x) if abs(x) < 1 else "{:,.2f}".format(x)


def to_int(x):
    """int() yang tidak meledak untuk nilai hilang/aneh dari gateway."""
    try:
        return int(x)
    except (TypeError, ValueError):
        return 0


def format_tokens(n):
    """Jumlah token gaya ribuan koma: 102,539,343 (ikut gaya `satuan`)."""
    return "{:,.0f}".format(to_int(n))


def format_quota(x):
    """quota_per_unit tampil sebagai bilangan bulat bila memang bulat."""
    try:
        f = float(x)
    except (TypeError, ValueError):
        return str(x)
    return "{:,.0f}".format(f) if f.is_integer() else "{:,.4f}".format(f)


def quota_note(q, qpu):
    """'  (2,500,000 quota)' — nilai quota mentah sebagai konteks angka dolar."""
    if q is None:
        return ""
    return "  (%s quota)" % format_quota(q)


def kurs_str(rates):
    """'CNY=7, IDR=18000, USD=1' dari currency_rates."""
    if not isinstance(rates, dict) or not rates:
        return "-"
    return ", ".join("%s=%s" % (k, v) for k, v in sorted(rates.items()))


def format_idr(x):
    """Format rupiah gaya Indonesia: Rp 200.000 (tanpa desimal)."""
    try:
        return "Rp " + "{:,.0f}".format(float(x)).replace(",", ".")
    except (TypeError, ValueError):
        return "Rp -"


def fmt_ts(ts, fallback="—"):
    if not ts:
        return fallback
    try:
        return datetime.fromtimestamp(int(ts), WIB).strftime("%Y-%m-%d %H:%M")
    except (ValueError, OSError, OverflowError):
        return fallback


def quota_to_usd(q, qpu):
    try:
        return float(q) / float(qpu or DEFAULT_QUOTA_PER_UNIT)
    except (TypeError, ValueError, ZeroDivisionError):
        return 0.0


def summarize_tokens(logs, qpu):
    """Ringkasan pemakaian dalam satuan token dari daftar log.

    Hanya baris `type == 2` (pemakaian) yang membawa token; baris error/refund
    punya 0 token dan diabaikan. Penting: endpoint /api/log/token hanya
    mengembalikan MaxRecentItems baris terakhir (default 1000 di new-api), jadi
    ini ringkasan jendela log — bukan total seumur hidup key.
    """
    consume = [l for l in logs if l.get("type") == 2]
    prompt = sum(to_int(l.get("prompt_tokens")) for l in consume)
    completion = sum(to_int(l.get("completion_tokens")) for l in consume)
    quota = sum(to_int(l.get("quota")) for l in consume)

    by_model = {}
    for l in consume:
        name = l.get("model_name") or "(tanpa model)"
        m = by_model.setdefault(name, {"model": name, "requests": 0,
                                       "prompt_tokens": 0, "completion_tokens": 0,
                                       "quota": 0})
        m["requests"] += 1
        m["prompt_tokens"] += to_int(l.get("prompt_tokens"))
        m["completion_tokens"] += to_int(l.get("completion_tokens"))
        m["quota"] += to_int(l.get("quota"))

    times = [to_int(l.get("created_at")) for l in logs if l.get("created_at")]
    total_tokens = prompt + completion
    cost = quota_to_usd(quota, qpu)
    return {
        # kontrak JSON seragam di kedua mode: kunci arsip selalu ada (None/0/false
        # bila arsip nonaktif) supaya script pemanggil tidak KeyError hanya karena
        # `local_store` diubah.
        "source": "api",
        "window_logs": len(logs),
        "stored_logs": None,
        "added": 0,
        "gap": False,
        "requests": len(consume),
        "prompt_tokens": prompt,
        "completion_tokens": completion,
        "total_tokens": total_tokens,
        "avg_tokens_per_request": (total_tokens / len(consume)) if consume else 0.0,
        "quota": quota,
        "cost_usd": cost,
        "cost_per_million_tokens": (cost / total_tokens * 1_000_000) if total_tokens else 0.0,
        "first_at": min(times) if times else 0,
        "last_at": max(times) if times else 0,
        "by_model": sorted(by_model.values(),
                           key=lambda m: (-m["quota"], m["model"])),
    }


# --------------------------------------------------------------- store lokal
#
# /api/log/token hanya mengembalikan MaxRecentItems baris terakhir (1000 di
# new-api, hardcode) dan tidak punya parameter paginasi, jadi angka token dari
# jendela itu akan selalu terpotong. Arsip lokal (sqlite) bisa mengakumulasi log
# antar-run sehingga cakupannya lebih lengkap.
#
# Arsip ini DEFAULT OFF — tidak ada file yang dibuat sampai diaktifkan lewat
# "local_store":true di config.json, $AIHUB_STORE=1, atau --store.
#
# Isi arsip sengaja minimal (tanpa ip/username/content) dan di-scope dengan
# SHA-256 API key, bukan key-nya, supaya file lokal tidak membocorkan kredensial.

TRUTHY = ("1", "true", "yes", "on")

SCHEMA = """
CREATE TABLE IF NOT EXISTS logs (
    key_hash          TEXT    NOT NULL,
    request_id        TEXT    NOT NULL,
    id                INTEGER NOT NULL DEFAULT 0,
    created_at        INTEGER NOT NULL DEFAULT 0,
    type              INTEGER NOT NULL DEFAULT 0,
    model_name        TEXT    NOT NULL DEFAULT '',
    prompt_tokens     INTEGER NOT NULL DEFAULT 0,
    completion_tokens INTEGER NOT NULL DEFAULT 0,
    quota             INTEGER NOT NULL DEFAULT 0,
    use_time          INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (key_hash, request_id)
);
CREATE INDEX IF NOT EXISTS idx_logs_key_time ON logs (key_hash, created_at);
"""

# `id` dari gateway bukan identitas: itu nomor urut jendela (1 = terbaru) yang
# berubah tiap fetch — dedupe pakai (key_hash, id) membuat arsip beku di 1000
# baris pertama. Dedupe sekarang pakai request_id (stabil antar-run).
SCHEMA_VERSION = 2


def migrate_store(conn):
    """Naikkan arsip lama (PK id) ke PK request_id, sekali jalan.

    Baris tanpa request_id yang bisa dibaca (arsip v1) dijadikan `legacy:<id>`
    supaya run pertama setelah upgrade: log window yang barannya sudah ada di
    v1 dianggap duplikat (tidak menghitung ganda), dan dihapus saat run itu
    karena digantikan baris request_id asli.
    """
    ver = conn.execute("PRAGMA user_version").fetchone()[0]
    if ver == SCHEMA_VERSION:
        return
    tables = [r[0] for r in conn.execute(
        "SELECT name FROM sqlite_master WHERE type='table'")]
    cols = [r[1] for r in conn.execute("PRAGMA table_info(logs)")] \
        if "logs" in tables else []
    if cols and "request_id" not in cols:
        # arsip v1 (PK id): rename, bikin skema baru, salin sbg legacy:<id>,
        # buang v1. Run pertama sesudah upgrade: log window yang barannya
        # sudah ada di v1 tidak dihitung ganda (legacy:<id> kena REPLACE),
        # lalu baris legacy itu hilang karena digantikan request_id asli.
        conn.execute("ALTER TABLE logs RENAME TO logs_v1")
        conn.executescript(SCHEMA)
        conn.execute("""
            INSERT OR REPLACE INTO logs (key_hash, request_id, id, created_at,
                type, model_name, prompt_tokens, completion_tokens, quota, use_time)
            SELECT key_hash, 'legacy:' || id, id, created_at, type, model_name,
                   prompt_tokens, completion_tokens, quota, use_time
            FROM logs_v1 WHERE id IS NOT NULL
        """)
        conn.execute("DROP TABLE logs_v1")
    else:
        conn.executescript(SCHEMA)
    conn.execute("PRAGMA user_version = %d" % SCHEMA_VERSION)
    conn.commit()

def scope_of(key):
    """Identitas arsip untuk sebuah API key: SHA-256, bukan key itu sendiri."""
    return hashlib.sha256(key.encode("utf-8")).hexdigest()[:32]

def truthy(v):
    """True untuk 'true'/'1'/'yes'/'on' (dari env atau config.json)."""
    if isinstance(v, bool):
        return v
    return v is not None and str(v).strip().lower() in TRUTHY

def store_enabled(args):
    """Arsip lokal default OFF. Urutan: --no-store > --store > $AIHUB_STORE >
    `local_store` di config.json > off."""
    if args.no_store:
        return False
    if args.store:
        return True
    if truthy(os.environ.get("AIHUB_STORE")):
        return True
    return truthy(load_config().get("local_store"))

def open_store(path=None):
    """Buka arsip log lokal. Mengembalikan (conn, error_message)."""
    path = path or DB_PATH
    try:
        parent = os.path.dirname(path)
        if parent:
            # 0700: direktori tidak perlu bisa dibaca user lain
            os.makedirs(parent, mode=0o700, exist_ok=True)
        # File dibuat lebih dulu dengan mode 0600 supaya sqlite tidak sempat
        # membuatnya 0644 (umask default) sebelum di-chmod. chmod tetap dipanggil
        # untuk merapikan file lama yang mode-nya longgar.
        if not os.path.exists(path):
            os.close(os.open(path, os.O_CREAT | os.O_WRONLY, 0o600))
        conn = sqlite3.connect(path)
        os.chmod(path, stat.S_IRUSR | stat.S_IWUSR)
        migrate_store(conn)
        conn.commit()
        return conn, None
    except (OSError, sqlite3.Error) as e:
        return None, "%s (%s)" % (e, path)

def log_identity(l):
    """request_id = identitas stabil log antar-run. `id` gateway cuma nomor
    urut jendela (1 = terbaru, berubah tiap fetch), tidak boleh dipakai.
    Baris tanpa request_id (kasus langka) → sidik jari konten deterministik;
    dua request identik di detik sama berbagi kunci → yang kedua diabaikan
    (undercount kecil, lebih aman dari menghitung ganda)."""
    rid = str(l.get("request_id") or "").strip()
    if rid:
        return rid
    return "fp:%s:%s:%s:%s:%s:%s" % (
        to_int(l.get("created_at")), to_int(l.get("type")),
        l.get("model_name") or "", to_int(l.get("prompt_tokens")),
        to_int(l.get("completion_tokens")), to_int(l.get("quota")))


def store_logs(conn, scope, logs):
    """Arsipkan log baru. Mengembalikan (jumlah_baru, ada_gap).

    Dedupe lewat PRIMARY KEY (key_hash, request_id) + INSERT OR IGNORE, jadi
    menjalankan CLI berkali-kali tidak menghitung ganda. `ada_gap` benar bila
    log tertua yang baru diambil lebih baru dari log terbaru yang sudah
    diarsipkan — artinya ada request di antaranya yang tidak pernah terlihat
    (kalah cepat dari 1000 log).
    """
    rows = [(scope, log_identity(l), to_int(l.get("id")), to_int(l.get("created_at")),
             to_int(l.get("type")), str(l.get("model_name") or ""),
             to_int(l.get("prompt_tokens")), to_int(l.get("completion_tokens")),
             to_int(l.get("quota")), to_int(l.get("use_time")))
            for l in logs if l.get("request_id") or l.get("created_at")]
    if not rows:
        return 0, False
    prev_max, prev_count = conn.execute(
        "SELECT COALESCE(MAX(created_at), 0), COUNT(*) FROM logs WHERE key_hash = ?",
        (scope,)).fetchone()
    times = [r[3] for r in rows if r[3]]
    oldest = min(times) if times else 0
    before = conn.total_changes
    conn.executemany(
        "INSERT OR IGNORE INTO logs (key_hash, request_id, id, created_at, type,"
        " model_name, prompt_tokens, completion_tokens, quota, use_time)"
        " VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", rows)
    # seam v1→v2: baris migrasi `legacy:<id>` yang isinya sama dengan log window
    # baru adalah log yang sama dilihat dua kali — sisakan salinan request_id
    # asli. Harus SETELAH insert: pada run pertama pasca-migrasi, baris pembanding
    # baru saja masuk lewat window, bukan sudah ada di arsip.
    conn.execute("""
        DELETE FROM logs WHERE key_hash = ? AND request_id LIKE 'legacy:%'
          AND (created_at, type, model_name, prompt_tokens, completion_tokens,
               quota, use_time) IN (
              SELECT created_at, type, model_name, prompt_tokens,
                     completion_tokens, quota, use_time
              FROM logs WHERE key_hash = ? AND request_id NOT LIKE 'legacy:%')
    """, (scope, scope))
    conn.commit()
    added = conn.total_changes - before
    gap = bool(prev_count and oldest and oldest > prev_max)
    return added, gap

def store_summary(conn, scope, qpu, window_logs, added=0, gap=False):
    """Ringkasan token dari arsip lokal; bentuknya sama dengan summarize_tokens."""
    stored, first_at, last_at = conn.execute(
        "SELECT COUNT(*), COALESCE(MIN(created_at), 0), COALESCE(MAX(created_at), 0)"
        " FROM logs WHERE key_hash = ?", (scope,)).fetchone()
    requests, prompt, completion, quota = conn.execute(
        "SELECT COUNT(*), COALESCE(SUM(prompt_tokens), 0),"
        " COALESCE(SUM(completion_tokens), 0), COALESCE(SUM(quota), 0)"
        " FROM logs WHERE key_hash = ? AND type = 2", (scope,)).fetchone()
    by_model = [{"model": name or "(tanpa model)", "requests": n,
                 "prompt_tokens": p, "completion_tokens": c, "quota": q}
                for name, n, p, c, q in conn.execute(
                    "SELECT model_name, COUNT(*), COALESCE(SUM(prompt_tokens), 0),"
                    " COALESCE(SUM(completion_tokens), 0), COALESCE(SUM(quota), 0)"
                    " FROM logs WHERE key_hash = ? AND type = 2"
                    " GROUP BY model_name ORDER BY SUM(quota) DESC, model_name",
                    (scope,))]
    total_tokens = prompt + completion
    cost = quota_to_usd(quota, qpu)
    return {
        "source": "arsip lokal",
        "window_logs": window_logs,
        "stored_logs": stored,
        "added": added,
        "gap": gap,
        "requests": requests,
        "prompt_tokens": prompt,
        "completion_tokens": completion,
        "total_tokens": total_tokens,
        "avg_tokens_per_request": (total_tokens / requests) if requests else 0.0,
        "quota": quota,
        "cost_usd": cost,
        "cost_per_million_tokens": (cost / total_tokens * 1_000_000) if total_tokens else 0.0,
        "first_at": first_at,
        "last_at": last_at,
        "by_model": by_model,
    }


